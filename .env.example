# Copy to .env. Never commit .env.

# Shared Directus (other projects live here too; tokens must be scoped to le_* only)
DIRECTUS_URL=https://cms.shwezstudio.in
DIRECTUS_TOKEN=
# Admin token used only by infra/directus/setup.ts
DIRECTUS_SETUP_TOKEN=

# pg-boss queue DB (lead_queue on the Directus Postgres, via SSH tunnel in dev)
QUEUE_DATABASE_URL=

# dry_run (default) | allowlist | live. Only Harshad switches to live.
# is_test campaigns never send live, whatever this is set to.
SEND_MODE=dry_run
SEND_ALLOWLIST=

# APIs (added as each phase needs them)
ANTHROPIC_API_KEY=
# Places API (New); read by the worker and the admin server (campaign preview).
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
HUNTER_API_KEY=
REACHER_URL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Reddit app (reddit.com/prefs/apps, type "script"): read-only search, answered by hand
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=

# Admin app (session password: 32+ random chars, e.g. `openssl rand -base64 32`)
NUXT_SESSION_PASSWORD=
# Map picker in the browser: a separate key restricted to Maps JavaScript API + your site (HTTP referrers)
NUXT_PUBLIC_GOOGLE_MAPS_KEY=
NUXT_DIRECTUS_URL=https://cms.shwezstudio.in
NUXT_PUBLIC_SITE_URL=
