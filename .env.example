# Copy to .env. Never commit .env.

# Local dev Directus admin (infra/docker-compose.dev.yml)
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Worker
DATABASE_URL=postgres://leads:leads_dev@localhost:5433/leads
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

# dry_run (default) | allowlist | live. Only Harshad switches to live.
SEND_MODE=dry_run
SEND_ALLOWLIST=

# APIs (added as each phase needs them)
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
HUNTER_API_KEY=
REACHER_URL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=

# Admin app
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NUXT_PUBLIC_SITE_URL=
