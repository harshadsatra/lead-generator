{
  "name": "shwez-lead-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && node --experimental-strip-types --no-warnings --test infra/directus/*.test.ts",
    "le:setup": "node --experimental-strip-types --no-warnings --env-file=.env infra/directus/setup.ts",
    "le:cleanup-test": "node --experimental-strip-types --no-warnings --env-file=.env infra/directus/cleanup-test.ts"
  }
}
